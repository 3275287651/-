# 复制为 .env 后按需修改；docker compose 会自动读取同目录下的 .env

# 对外访问端口
HTTP_PORT=8080

# 数据库
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=trademark
MYSQL_USER=tm_user
MYSQL_PASSWORD=tm_pass_2026

# 安全：务必改成长随机串（用于登录令牌签名）
SECRET_KEY=please-change-this-to-a-long-random-string

# 首次启动自动创建的超级管理员（登录后请立即改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin888

# 唯一编号前缀，格式 {前缀}-{日期}-{流水号}，如 TM-20260927-0001
SERIAL_PREFIX=TM

# 允许的跨域来源（前后端同域部署时可留空）
CORS_ORIGINS=http://localhost:8080