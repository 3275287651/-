# 复制为 .env 后按需修改；docker compose 会自动读取同目录下的 .env

# 对外访问端口
HTTP_PORT=8080

# 数据库
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=trademark
MYSQL_USER=tm_user
MYSQL_PASSWORD=tm_pass_2026

# 安全：务必改成长随机串（用于登录令牌签名）
SECRET_KEY=please-change-this-to-a-long-random-string

# 首次启动自动创建的超级管理员（登录后请立即改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin888

# 唯一编号前缀，格式 {前缀}-{日期}-{流水号}，如 TM-20260927-0001
SERIAL_PREFIX=TM

# 允许的跨域来源（前后端同域部署时可留空）
CORS_ORIGINS=http://localhost:8080

# ===== 版本与升级 =====
APP_VERSION=1.0.3
# 升级清单签名校验密钥（厂商与你各持同一把；不配则后台无法校验升级清单）
UPGRADE_KEY=

# ===== 纵深防护 =====
# 反向代理（Nginx / 瑞数等）后面部署时置 true，才信任 X-Forwarded-For
TRUST_PROXY=false
# 单 IP 每分钟请求上限：普通接口 / 凭证类接口（验证码、注册、登录）
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_LOGIN_PER_MIN=30
# 请求签名与防重放：off=关闭 / write=仅写操作 / all=全部接口（启用后必须走 HTTPS）
SIGN_MODE=off
SIGN_WINDOW_SECONDS=300

# ===== 授权（License）=====
# 由 tools/license_gen.py init 生成的公钥 hex；不配则授权模块不启用
LICENSE_PUBLIC_KEY=
# warn=只提示不拦截 / block_admin_write=超期后禁后台写操作 / block_all=超期后仅保留登录与授权
LICENSE_ENFORCE=warn